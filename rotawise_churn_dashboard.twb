            <column-instance column='[Calculation_1298586521751554]' derivation='None' name='[none:Calculation_1298586521751554:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1298586602565641]' derivation='None' name='[none:Calculation_1298586602565641:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1298586602606602]' derivation='None' name='[none:Calculation_1298586602606602:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1298586523176964]' derivation='User' name='[usr:Calculation_1298586523176964:qk]' pivot='key' type='quantitative' />
