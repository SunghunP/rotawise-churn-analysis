      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>When do customers leave?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='12'>Early: 18% of monthly accounts are gone by month 6.</run>
          </formatted-text>
        </title>
      </layout-options>
