        <calculation class='tableau' formula='[SignupDate] &lt;= #2025-09-30#&#13;&#10;  AND (ISNULL([ChurnDate]) OR [ChurnDate] &gt; #2025-09-30#)' />
      </column>
      <column caption='Churned In Window' datatype='integer' name='[Calculation_1298586522779651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ChurnDate] &gt; #2025-09-30# AND [ChurnDate] &lt;= #2026-09-30#&#13;&#10;       THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_1298586523176964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1298586522779651])/COUNT([AccountID])' />
      </column>
      <column caption='Churned Flag' datatype='integer' name='[Calculation_1298586590842885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churned] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='% Churn of All Monthly' datatype='real' default-format='p0.00%' name='[Calculation_1298586591260678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1298586590842885]) / TOTAL(COUNT([AccountID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative % Lost' datatype='real' name='[Calculation_1298586600497160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1298586590842885])) / TOTAL(COUNT([AccountID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Risk Score' datatype='integer' name='[Calculation_1298586602565641]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [OnboardingCompleted] = &quot;No&quot; THEN 4 ELSE 0 END&#13;&#10;+ IF [TrainingSessions] = 0 THEN 3 ELSE 0 END&#13;&#10;+ IF [SeatUtilizationPct] &lt; 60 THEN 3 ELSE 0 END&#13;&#10;+ IF [DaysToGoLive] &gt;= 31 THEN 3 ELSE 0 END&#13;&#10;+ IF [IntegrationsConnected] &lt;= 1 THEN 2 ELSE 0 END&#13;&#10;+ IF [FeatureAdoptionPct] &lt; 50 THEN 2 ELSE 0 END&#13;&#10;+ IF [NPS] &lt;= 6 OR ISNULL([NPS]) THEN 2 ELSE 0 END&#13;&#10;+ IF [EscalatedTickets90d] &gt;= 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Risk Level' datatype='string' name='[Calculation_1298586602606602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1298586602565641] &lt;= 8 THEN &quot;Green&quot;&#13;&#10;ELSEIF [Calculation_1298586602565641] &lt;= 15 THEN &quot;Yellow&quot;&#13;&#10;ELSE &quot;Red&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Green&quot;' value='Green (low) 0-8' />
          <alias key='&quot;Red&quot;' value='Red (high) 16-20' />
          <alias key='&quot;Yellow&quot;' value='Yellow (mid) 9-15' />
        </aliases>
      </column>
      <column caption='Churn Date' datatype='date' name='[ChurnDate]' role='dimension' type='ordinal' />
      <column caption='Churn Reason' datatype='string' name='[ChurnReason]' role='dimension' type='nominal' />
